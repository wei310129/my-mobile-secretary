{
  "schemaVersion": 1,
  "enabledVariable": "TOOLING_PRODUCER_ENABLED",
  "appIdVariable": "TOOLING_PRODUCER_APP_ID",
  "appPrivateKeySecret": "TOOLING_PRODUCER_APP_PRIVATE_KEY",
  "environment": "tooling-producer",
  "receiptIssueTitle": "[Coordination] Producer handoff receipts",
  "maxAutomaticRebuilds": 1,
  "events": [
    {
      "eventId": "TR-DESKTOP-ROUTE-BENCHMARK-START",
      "producerLane": "laptop",
      "consumerLane": "desktop",
